{$FINDLINK_DOMAIN} {
  encode gzip
  handle_path /downloads/windows/* {
    root * /srv/downloads/windows
    @metadata path /latest.yml
    @installer path_regexp installer ^/FindLink-Starter-[0-9]+\.[0-9]+\.[0-9]+-Setup\.exe(\.blockmap)?$
    route {
      header @metadata Cache-Control "no-cache"
      file_server @metadata
      header @installer Cache-Control "public, max-age=31536000, immutable"
      file_server @installer
      respond 404
    }
  }
  handle_path /downloads/* {
    root * /srv/downloads
    file_server
  }
  handle {
    reverse_proxy 127.0.0.1:9070 {
      header_up X-Real-IP {remote_host}
    }
  }
}
