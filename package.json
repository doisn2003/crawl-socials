{
  "name": "findlink-desktop",
  "version": "0.4.0-rebuild.5.4",
  "description": "FindLink",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "start": "npm run build && electron .",
    "collect:facebook": "npm run build && node scripts/run-facebook-collector.mjs",
    "collect:threads": "npm run build && node scripts/run-threads-collector.mjs",
    "threads:control": "node scripts/run-threads-collector.mjs",
    "collector:control": "node scripts/run-facebook-collector.mjs",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.backend.json && node scripts/copy-assets.mjs",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "backend:migrate": "node dist/backend/index.js --migrate",
    "backend:start": "node dist/backend/index.js",
    "backend:test": "node scripts/starter-integration.mjs",
    "starter:preview": "npm run build && node scripts/starter-preview.mjs",
    "dist:starter": "node scripts/package-starter.mjs",
    "pack:starter:qa": "node scripts/package-starter.mjs --qa --dir",
    "dist:starter:qa": "node scripts/package-starter.mjs --qa",
    "test": "npm run build && npm run test:unit",
    "test:unit": "tsc -p tsconfig.tests.json && node scripts/copy-semantic-assets.mjs .test-build/src/domain && node --test .test-build/tests/*.test.js tests/*.test.mjs",
    "pack:dir": "npm run build && electron-builder --dir --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "electron-updater": "6.8.11",
    "exceljs": "4.4.0",
    "franc-min": "6.2.0",
    "pg": "8.23.1",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "electron": "44.10.0",
    "electron-builder": "26.15.3",
    "railway": "3.16.0",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "io.csd.desktop",
    "productName": "FindLink",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/backend/**",
      "package.json"
    ],
    "win": {
      "icon": "src/renderer/findlink-mark.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "FindLink-Portable-${version}.exe"
    }
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
